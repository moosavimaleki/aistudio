{
  "manifest_version": 3,
  "name": "AI Studio Container Token Bridge",
  "version": "0.1.0",
  "description": "Internal staging bridge between the container Chrome and Token Factory",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:3345/*",
    "__AISTUDIO_GOOGLE_PERMISSION__"
  ],
  "background": {
    "service_worker": "background/entry.js"
  },
  "content_scripts": [
    {
      "matches": ["__AISTUDIO_MATCH__"],
      "js": ["dist/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["__AISTUDIO_MATCH__"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ]
}
