#!/usr/bin/env bash
set -euo pipefail

/app/supervisor/wait-display

auth_args=(-nopw)
if [[ -n "${VNC_PASSWORD:-}" ]]; then
    if (( ${#VNC_PASSWORD} > 8 )); then
        echo 'VNC_PASSWORD must be at most 8 characters' >&2
        exit 1
    fi
    umask 077
    auth_file=/tmp/x11vnc.passwd
    x11vnc -storepasswd "$VNC_PASSWORD" "$auth_file" >/dev/null
    auth_args=(-rfbauth "$auth_file")
fi

exec x11vnc -display :99 "${auth_args[@]}" -forever -shared -rfbport 5900
